cmake_minimum_required(VERSION 3.20)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(test_dir "${TEST_ROOT}/${test_id}")
file(MAKE_DIRECTORY "${test_dir}")
set(source "module m;endmodule\n")
file(WRITE "${test_dir}/input.sv" "${source}")
file(WRITE "${test_dir}/clean.sv" "module m;\nendmodule\n")
file(WRITE "${test_dir}/config.yaml" "version: \"0.1.0\"\n")
string(ASCII 27 escape)
set(color_env --unset=NO_COLOR TERM=xterm)

function(without_styles result text)
  foreach(code IN ITEMS 0 1 7 27 31 32 36)
    string(REPLACE "${escape}[${code}m" "" text "${text}")
  endforeach()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()

function(diff_output mode expected_status)
  # Captured stdout is a pipe, so automatic color must leave a plain patch.
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env ${color_env}
      "${FORMATTER}" --diff "--color=${mode}"
      --config "${test_dir}/config.yaml" ${ARGN}
    WORKING_DIRECTORY "${test_dir}"
    INPUT_FILE "${test_dir}/input.sv"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE errors
    TIMEOUT 10)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Expected exit ${expected_status}, got ${status}: ${errors}")
  endif()
  string(FIND "${errors}" "${escape}[" error_color)
  if(NOT error_color EQUAL -1)
    message(FATAL_ERROR "Diff color escaped into stderr: ${errors}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
  set(last_errors "${errors}" PARENT_SCOPE)
endfunction()

foreach(input IN ITEMS file stdin)
  set(input_args)
  if(input STREQUAL "file")
    list(APPEND input_args input.sv)
  endif()

  diff_output(never 0 ${input_args})
  set(plain "${last_output}")
  if(NOT plain MATCHES "^diff --git ")
    message(FATAL_ERROR "Missing plain patch: ${plain}")
  endif()
  diff_output(auto 0 ${input_args})
  if(NOT "${last_output}" STREQUAL "${plain}")
    message(FATAL_ERROR "Automatic color changed a captured patch")
  endif()

  diff_output(always 0 ${input_args})
  set(colored "${last_output}")
  string(FIND "${colored}" "${escape}[31m-module m;endmodule${escape}[0m" removed)
  string(FIND "${colored}" "${escape}[32m+module m;${escape}[0m" added)
  string(FIND "${colored}" "${escape}[36m@@" hunk)
  if(removed EQUAL -1 OR added EQUAL -1 OR hunk EQUAL -1)
    message(FATAL_ERROR "Missing diff colors: ${colored}")
  endif()
  without_styles(restored "${colored}")
  if(NOT "${restored}" STREQUAL "${plain}")
    message(FATAL_ERROR "Color changed the patch contents")
  endif()
  if(NOT "${last_errors}" STREQUAL "")
    message(FATAL_ERROR "Unexpected diff diagnostics: ${last_errors}")
  endif()

  set(color_env NO_COLOR=1 TERM=dumb)
  diff_output(always 0 ${input_args})
  if(NOT "${last_output}" STREQUAL "${colored}")
    message(FATAL_ERROR "Explicit always did not override the environment")
  endif()
  diff_output(auto 0 ${input_args})
  if(NOT "${last_output}" STREQUAL "${plain}")
    message(FATAL_ERROR "Automatic color ignored the environment")
  endif()
  set(color_env --unset=NO_COLOR TERM=xterm)

  if(input STREQUAL "file")
    diff_output(always 1 --check ${input_args})
    if(NOT "${last_output}" STREQUAL "${colored}" OR
       NOT last_errors MATCHES "Needs formatting:")
      message(FATAL_ERROR "Color changed --check --diff behavior")
    endif()
    diff_output(never 1 --check ${input_args})
    if(NOT "${last_output}" STREQUAL "${plain}")
      message(FATAL_ERROR "Plain --check --diff changed the patch")
    endif()
  endif()
endforeach()

diff_output(always 0 clean.sv)
if(NOT "${last_output}" STREQUAL "" OR NOT "${last_errors}" STREQUAL "")
  message(FATAL_ERROR "Clean diff emitted output")
endif()
file(READ "${test_dir}/input.sv" after)
if(NOT "${after}" STREQUAL "${source}")
  message(FATAL_ERROR "Colored diff modified the input file")
endif()

# One-to-one replacements emphasize spacing without highlighting matched code.
set(source "module m;\n  assign a=b;\nendmodule\n")
file(WRITE "${test_dir}/input.sv" "${source}")
foreach(input IN ITEMS file stdin)
  set(input_args)
  if(input STREQUAL "file")
    list(APPEND input_args input.sv)
  endif()
  diff_output(never 0 ${input_args})
  set(plain "${last_output}")
  diff_output(auto 0 ${input_args})
  if(NOT "${last_output}" STREQUAL "${plain}")
    message(FATAL_ERROR "Automatic intraline highlighting changed a captured patch")
  endif()
  diff_output(always 0 ${input_args})
  set(colored "${last_output}")
  string(FIND "${colored}" "a${escape}[7m ${escape}[27m=${escape}[7m ${escape}[27mb;" spaces)
  if(spaces EQUAL -1)
    message(FATAL_ERROR "Inserted spaces were not highlighted separately: ${colored}")
  endif()
  without_styles(restored "${colored}")
  if(NOT "${restored}" STREQUAL "${plain}")
    message(FATAL_ERROR "Intraline highlighting changed patch contents")
  endif()
  if(input STREQUAL "file")
    diff_output(always 1 --check ${input_args})
    if(NOT "${last_output}" STREQUAL "${colored}" OR
       NOT last_errors MATCHES "Needs formatting:")
      message(FATAL_ERROR "Intraline highlighting changed check behavior")
    endif()
  endif()
endforeach()
file(READ "${test_dir}/input.sv" after)
if(NOT "${after}" STREQUAL "${source}")
  message(FATAL_ERROR "Intraline highlighting modified the input file")
endif()
file(REMOVE_RECURSE "${test_dir}")
