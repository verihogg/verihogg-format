cmake_minimum_required(VERSION 3.20)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(test_dir "${TEST_ROOT}/${test_id}")
file(MAKE_DIRECTORY "${test_dir}")
set(source "// before 1\n// before 2\nmodule m;\n  assign a=b;\nendmodule\n")
file(WRITE "${test_dir}/space #%.sv" "${source}")
file(WRITE "${test_dir}/second.sv" "// extra 1\n// extra 2\n${source}")
file(WRITE "${test_dir}/clean.sv" "module m;\nendmodule\n")
file(WRITE "${test_dir}/config.yaml" "version: \"0.1.0\"\n")
string(ASCII 27 escape)
set(color_mode never)
set(terminal_program unknown)

function(without_hyperlinks result text)
  string(FIND "${text}" "${escape}]8;;" start)
  while(NOT start EQUAL -1)
    string(SUBSTRING "${text}" ${start} -1 tail)
    string(FIND "${tail}" "${escape}\\" finish)
    if(finish EQUAL -1)
      message(FATAL_ERROR "Unterminated hyperlink: ${text}")
    endif()
    math(EXPR after "${finish} + 2")
    string(SUBSTRING "${text}" 0 ${start} before)
    string(SUBSTRING "${tail}" ${after} -1 tail)
    set(text "${before}${tail}")
    string(FIND "${text}" "${escape}]8;;" start)
  endwhile()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()

function(diff_output mode expected_status)
  # Terminal environment variables must not enable automatic links in a pipe.
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "TERM_PROGRAM=${terminal_program}" TERM=xterm
      TMUX= STY= SSH_CONNECTION= NO_COLOR=1
      "${FORMATTER}" --diff "--color=${color_mode}" "--hyperlinks=${mode}"
      --config "${test_dir}/config.yaml" ${ARGN}
    WORKING_DIRECTORY "${test_dir}"
    INPUT_FILE "${test_dir}/space #%.sv"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE errors
    TIMEOUT 10)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Expected exit ${expected_status}, got ${status}: ${errors}")
  endif()
  string(FIND "${errors}" "${escape}]8;;" diagnostic_link)
  if(NOT diagnostic_link EQUAL -1)
    message(FATAL_ERROR "Diff hyperlink escaped into stderr: ${errors}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
  set(last_errors "${errors}" PARENT_SCOPE)
endfunction()

set(inputs "space #%.sv" second.sv)
diff_output(never 0 ${inputs})
set(plain "${last_output}")
foreach(terminal_program IN ITEMS unknown vscode WezTerm)
  diff_output(auto 0 ${inputs})
  if(NOT "${last_output}" STREQUAL "${plain}")
    message(FATAL_ERROR "Automatic hyperlinks changed captured output with TERM_PROGRAM=${terminal_program}")
  endif()
endforeach()
diff_output(always 0 ${inputs})
set(linked "${last_output}")
string(FIND "${linked}" "/space%20%23%25.sv#4${escape}\\@@" first_target)
string(FIND "${linked}" "/second.sv#6${escape}\\@@" second_target)
if(first_target EQUAL -1 OR second_target EQUAL -1)
  message(FATAL_ERROR "Hyperlinks did not use each file's original coordinates: ${linked}")
endif()
without_hyperlinks(restored "${linked}")
if(NOT "${restored}" STREQUAL "${plain}")
  message(FATAL_ERROR "Hyperlinks changed patch bytes")
endif()
diff_output(always 1 --check ${inputs})
if(NOT "${last_output}" STREQUAL "${linked}" OR
   NOT last_errors MATCHES "Needs formatting:")
  message(FATAL_ERROR "Hyperlinks changed check behavior")
endif()
diff_output(always 0 --no-links ${inputs})
if(NOT "${last_output}" STREQUAL "${linked}")
  message(FATAL_ERROR "--no-links disabled source hyperlinks")
endif()

set(color_mode always)
diff_output(never 0 ${inputs})
set(colored "${last_output}")
diff_output(always 0 ${inputs})
without_hyperlinks(restored "${last_output}")
if(NOT "${restored}" STREQUAL "${colored}")
  message(FATAL_ERROR "Hyperlinks changed diff highlighting")
endif()
set(color_mode never)

diff_output(never 0)
set(stdin_patch "${last_output}")
diff_output(always 0)
if(NOT "${last_output}" STREQUAL "${stdin_patch}")
  message(FATAL_ERROR "Stdin acquired a file hyperlink")
endif()
diff_output(always 0 clean.sv)
if(NOT "${last_output}" STREQUAL "" OR NOT "${last_errors}" STREQUAL "")
  message(FATAL_ERROR "Clean diff emitted output")
endif()
file(READ "${test_dir}/space #%.sv" after)
if(NOT "${after}" STREQUAL "${source}")
  message(FATAL_ERROR "Hyperlinked diff modified the input file")
endif()
file(REMOVE_RECURSE "${test_dir}")
