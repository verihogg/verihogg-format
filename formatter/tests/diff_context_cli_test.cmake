cmake_minimum_required(VERSION 3.20)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(test_dir "${TEST_ROOT}/${test_id}")
file(MAKE_DIRECTORY "${test_dir}")
set(source "")
foreach(i RANGE 1 5)
  string(APPEND source "// before ${i}\n")
endforeach()
string(APPEND source "module m;endmodule\n")
foreach(i RANGE 1 5)
  string(APPEND source "// after ${i}\n")
endforeach()
file(WRITE "${test_dir}/input.sv" "${source}")
file(WRITE "${test_dir}/config.yaml" "version: \"0.1.0\"\n")

function(diff_output expected_status)
  execute_process(
    COMMAND "${FORMATTER}" --diff --color=never
      --config "${test_dir}/config.yaml" ${ARGN}
    WORKING_DIRECTORY "${test_dir}"
    INPUT_FILE "${test_dir}/input.sv"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE errors
    TIMEOUT 10)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Expected exit ${expected_status}, got ${status}: ${errors}")
  endif()
  if(NOT output MATCHES "^diff --git ")
    message(FATAL_ERROR "Missing diff patch: ${output}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
  set(last_errors "${errors}" PARENT_SCOPE)
endfunction()

foreach(input IN ITEMS file stdin)
  set(input_args)
  if(input STREQUAL "file")
    list(APPEND input_args input.sv)
  endif()
  diff_output(0 ${input_args})
  set(default_patch "${last_output}")
  foreach(context IN ITEMS 0 1 3 5)
    diff_output(0 --diff-context "${context}" ${input_args})
    set(patch "${last_output}")
    if(NOT "${last_errors}" STREQUAL "")
      message(FATAL_ERROR "Unexpected diff diagnostics: ${last_errors}")
    endif()
    string(REGEX MATCHALL "\n // (before|after) [0-9]+" context_lines "${patch}")
    list(LENGTH context_lines context_count)
    math(EXPR expected_context "2 * ${context}")
    if(NOT context_count EQUAL expected_context)
      message(FATAL_ERROR "Expected ${expected_context} context lines, got ${context_count}: ${patch}")
    endif()
    if(context EQUAL 0 AND NOT patch MATCHES "@@ -6 \\+6,2 @@")
      message(FATAL_ERROR "Incorrect zero-context hunk range: ${patch}")
    endif()
    if(context EQUAL 3 AND NOT "${patch}" STREQUAL "${default_patch}")
      message(FATAL_ERROR "Default context is not three lines")
    endif()
    diff_output(0 "-U${context}" ${input_args})
    if(NOT "${last_output}" STREQUAL "${patch}")
      message(FATAL_ERROR "Short and long diff-context options disagree")
    endif()
    if(input STREQUAL "file")
      diff_output(1 --check "-U${context}" ${input_args})
      if(NOT "${last_output}" STREQUAL "${patch}" OR
         NOT last_errors MATCHES "Needs formatting:")
        message(FATAL_ERROR "Context changed --check --diff behavior")
      endif()
    endif()
  endforeach()
endforeach()

file(READ "${test_dir}/input.sv" after)
if(NOT "${after}" STREQUAL "${source}")
  message(FATAL_ERROR "Diff context modified the input file")
endif()
file(REMOVE_RECURSE "${test_dir}")
